[/]
desktop-effects-workspace=false
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:separator@cinnamon.org:1', 'panel1:left:2:grouped-window-list@cinnamon.org:2', 'panel1:right:2:xapp-status@cinnamon.org:4', 'panel1:right:3:notifications@cinnamon.org:5', 'panel1:right:4:printers@cinnamon.org:6', 'panel1:right:5:removable-drives@cinnamon.org:7', 'panel1:right:7:keyboard@cinnamon.org:8', 'panel1:right:8:favorites@cinnamon.org:9', 'panel1:right:10:network@cinnamon.org:10', 'panel1:right:11:power@cinnamon.org:12', 'panel1:right:12:calendar@cinnamon.org:13', 'panel1:right:13:cornerbar@cinnamon.org:14', 'panel1:right:1:multicore-sys-monitor@ccadeptic23:15', 'panel1:right:0:workspace-switcher@cinnamon.org:16', 'panel1:right:9:sound150@claudiux:17']
favorite-apps=['mintinstall.desktop', 'cinnamon-settings.desktop', 'cinnamon-network-panel.desktop', 'nm-connection-editor.desktop']
hotcorner-layout=['expo:false:0', 'scale:false:0', 'scale:false:0', 'desktop:false:0']
next-applet-id=18
panel-edit-mode=false
panel-zone-symbolic-icon-sizes='[{"panelId": 1, "left": 28, "center": 28, "right": 16}]'
panels-height=['1:40']
window-effect-speed=1
workspace-expo-view-as-grid=false

[cinnamon-session]
quit-time-delay=60

[desktop/applications/calculator]
exec='gnome-calculator'

[desktop/applications/terminal]
exec='alacritty'
exec-arg='--'

[desktop/input-sources]
sources=[('xkb', 'us')]
xkb-options=['terminate:ctrl_alt_bksp', 'caps:ctrl_modifier']

[desktop/interface]
cursor-blink-time=1200
cursor-size=24
cursor-theme='Bibata-Modern-Classic'
gtk-enable-primary-paste=false
gtk-theme='Mint-Y-Dark-Aqua'
icon-theme='Mint-Y-Sand'
text-scaling-factor=1.3000000000000003

[desktop/keybindings]
custom-list=['custom0', 'custom1', 'custom2', '__dummy__']

[desktop/keybindings/custom-keybindings/custom0]
binding=['<Super>a']
command='@HOME@/.local/bin/rofi-combi-menu'
name='rofi-combi-menu'

[desktop/keybindings/custom-keybindings/custom1]
binding=['Print']
command='flameshot gui'
name='flameshot gui'

[desktop/keybindings/custom-keybindings/custom2]
binding=['<Super>v']
command='copyq show'
name='copyq show'

[desktop/keybindings/media-keys]
screenreader=@as []
screenshot=@as []
terminal=['<Primary><Alt>t', '<Super>Return', '<Super>t']

[desktop/keybindings/wm]
activate-window-menu=@as []
close=['<Alt>F4', '<Super>w']
move-to-center=['<Super>c']

[desktop/media-handling]
autorun-never=false

[desktop/peripherals/keyboard]
delay=uint32 380
repeat-interval=uint32 27

[desktop/peripherals/mouse]
double-click=400
drag-threshold=8
speed=-0.78695652173913044

[desktop/peripherals/touchpad]
click-method='areas'
speed=0.39999999999999991
tap-to-click=false

[desktop/screensaver]
layout-group=0

[desktop/sound]
allow-amplified-volume=false
event-sounds=false

[desktop/wm/preferences]
num-workspaces=3
workspace-names=['a', 'b', 'c']

[gestures]
swipe-down-2='PUSH_TILE_DOWN::end'
swipe-down-3='TOGGLE_OVERVIEW::end'
swipe-down-4='VOLUME_DOWN::end'
swipe-left-2='PUSH_TILE_LEFT::end'
swipe-left-3='WORKSPACE_NEXT::end'
swipe-left-4='WINDOW_WORKSPACE_PREVIOUS::end'
swipe-right-2='PUSH_TILE_RIGHT::end'
swipe-right-3='WORKSPACE_PREVIOUS::end'
swipe-right-4='WINDOW_WORKSPACE_NEXT::end'
swipe-up-2='PUSH_TILE_UP::end'
swipe-up-3='TOGGLE_EXPO::end'
swipe-up-4='VOLUME_UP::end'
tap-3='MEDIA_PLAY_PAUSE::end'

[launcher]
check-frequency=300
memory-limit=2048

[muffin]
experimental-features=['scale-monitor-framebuffer', 'x11-randr-fractional-scaling']
workspace-cycle=true

[settings-daemon/peripherals/keyboard]
numlock-state='off'

[settings-daemon/plugins/power]
critical-battery-action='shutdown'
lid-close-ac-action='suspend'
lid-close-battery-action='suspend'
sleep-display-ac=2700
sleep-display-battery=1800
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=2700

[theme]
name='Mint-Y-Dark-Aqua'
