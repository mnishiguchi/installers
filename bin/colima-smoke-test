#!/bin/bash
# Disposable Colima/Docker Compose smoke test for Apple Silicon macOS.
# Compatible with macOS system Bash 3.2. Requires a running default Colima VM.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: bash colima-smoke-test.sh

Tests the local colima Docker context, native ARM64 containers, read-only bind
mounts, Compose builds, HTTP forwarding, service DNS and PostgreSQL persistence.
Requires Colima to be running. Uses temporary resources and public images.
Set COLIMA_SMOKE_PORT to override the default localhost port (18080).
Removes only its own Compose containers, network, volume and test image.
Downloaded base images and build cache are retained. No global pruning.
USAGE
}

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
ok() { printf 'OK: %s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; exit 2 ;;
esac
[[ $# -eq 0 ]] || fail 'unexpected arguments'
[[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]] || fail 'Run in a native Apple Silicon macOS terminal.'
for tool in docker colima curl mktemp; do
  command -v "$tool" >/dev/null || fail "Missing command: $tool"
done

port=${COLIMA_SMOKE_PORT:-18080}
[[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && ((port <= 65535 && port >= 1024)) || fail 'COLIMA_SMOKE_PORT must be an integer from 1024 to 65535.'
# Explicit context: never accidentally test or clean up another Docker daemon.
D=(docker --context colima)

step 'Colima and Docker tools'
colima version
colima status || fail 'Start Colima first: colima start'
endpoint=$("${D[@]}" context inspect colima --format '{{.Endpoints.docker.Host}}')
case "$endpoint" in
  unix:///*) [[ -S "${endpoint#unix://}" ]] || fail 'Colima socket is not available.' ;;
  *) fail 'The colima context does not point to a local Unix socket.' ;;
esac
printf 'Docker endpoint: %s\n' "$endpoint"
"${D[@]}" version
"${D[@]}" compose version
"${D[@]}" buildx version
engine=$("${D[@]}" info --format '{{.OSType}}/{{.Architecture}}')
case "$engine" in
  linux/aarch64|linux/arm64) ok "Native Linux ARM64 engine ($engine)" ;;
  *) fail "Unexpected Docker engine architecture: $engine" ;;
esac

# Under HOME so Colima's default host filesystem sharing covers the fixture.
workdir=$(mktemp -d "$HOME/.colima-smoke-XXXXXXXX")
chmod 700 "$workdir"
suffix=$(basename "$workdir" | tr '[:upper:]' '[:lower:]')
project="${suffix#.}-$$"
marker="${project}-ok"
image="$project-web:smoke"
C=("${D[@]}" compose --project-directory "$workdir" --env-file "$workdir/.env" -f "$workdir/compose.yaml" -p "$project")
compose_started=false

cleanup() {
  rc=$?
  trap - EXIT INT TERM HUP
  set +e
  cleanup_failed=false
  if [[ "$compose_started" == true ]]; then
    if [[ "$rc" -ne 0 ]]; then
      printf '\n==> Failure diagnostics (disposable project only)\n' >&2
      "${C[@]}" ps -a >&2
      "${C[@]}" logs --no-color --tail 60 >&2
    fi
    printf '\n==> Remove disposable Compose resources\n'
    "${C[@]}" down --volumes --timeout 10 || cleanup_failed=true
    if [[ "$cleanup_failed" == false ]] && "${D[@]}" image inspect "$image" >/dev/null 2>&1; then
      "${D[@]}" image rm "$image" >/dev/null || cleanup_failed=true
    fi
  fi
  if [[ "$cleanup_failed" == false ]]; then
    # workdir is generated by mktemp above, not a user-supplied path.
    rm -rf -- "$workdir" || cleanup_failed=true
  fi
  if [[ "$cleanup_failed" == true ]]; then
    printf 'ERROR: Cleanup incomplete. Fixture retained at: %s\n' "$workdir" >&2
    printf 'Retry: '; printf '%q ' "${C[@]}" down --volumes --timeout 10; printf '\n'
    printf 'Then remove the test image if present: '; printf '%q ' "${D[@]}" image rm "$image"; printf '\n'
    [[ "$rc" -ne 0 ]] || rc=1
  elif [[ "$compose_started" == true ]]; then
    ok 'Disposable Compose resources removed'
  fi
  if [[ "$rc" -eq 0 ]]; then
    printf '\nPASS: All Colima smoke tests passed.\n'
  else
    printf '\nFAIL: Colima smoke test exited with status %s.\n' "$rc" >&2
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

step 'Basic container execution'
"${D[@]}" run --rm hello-world
arch=$("${D[@]}" run --rm alpine uname -m)
[[ "$arch" == aarch64 || "$arch" == arm64 ]] || fail "Unexpected container architecture: $arch"
ok "Container execution and native architecture ($arch)"

step 'Read-only host bind mount'
printf '%s\n' "$marker" > "$workdir/mount-marker"
"${D[@]}" run --rm -v "$workdir:/workspace:ro" alpine sh -c '
  test "$(cat /workspace/mount-marker)" = "$1" || exit 1
  if touch /workspace/should-not-exist 2>/dev/null; then exit 1; fi
' sh "$marker"
[[ ! -e "$workdir/should-not-exist" ]] || fail 'Read-only mount allowed a write.'
ok 'Host file accessible; container writes rejected'

step 'Create disposable Compose project'
printf 'SMOKE_PORT=%s\nSMOKE_IMAGE=%s\n' "$port" "$image" > "$workdir/.env"
printf '%s\n' "$marker" > "$workdir/index.html"
cat > "$workdir/Dockerfile" <<'DOCKERFILE'
FROM nginx:alpine
COPY index.html /usr/share/nginx/html/index.html
DOCKERFILE
cat > "$workdir/compose.yaml" <<'YAML'
services:
  web:
    image: ${SMOKE_IMAGE:?}
    build: .
    ports:
      - "127.0.0.1:${SMOKE_PORT:?}:80"
  db:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: smoke
      POSTGRES_PASSWORD: smoke-only
      POSTGRES_DB: smoke
    volumes:
      - dbdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U smoke -d smoke"]
      interval: 2s
      timeout: 3s
      retries: 30
volumes:
  dbdata:
YAML
# These variable names belong only to this disposable project. Exporting the
# intended values also prevents inherited variables from overriding .env.
export SMOKE_PORT="$port" SMOKE_IMAGE="$image"
"${C[@]}" config --quiet
printf 'Project: %s\nFixture: %s\n' "$project" "$workdir"
compose_started=true
"${C[@]}" up -d --build --wait --wait-timeout 120
"${C[@]}" ps
ok 'Compose build, startup and PostgreSQL health check'

step 'HTTP port forwarding'
url="http://127.0.0.1:$port/"
http_ready=false
for ((attempt=1; attempt<=30; attempt++)); do
  if response=$(curl --noproxy '*' --fail --silent --max-time 3 "$url") && [[ "$response" == "$marker" ]]; then
    http_ready=true
    break
  fi
  sleep 2
done
[[ "$http_ready" == true ]] || fail "Expected test page not reachable at $url"
ok "Host HTTP request reached the test container ($url)"

step 'Compose service discovery and networking'
response=$("${C[@]}" exec -T db wget -q -O - http://web/)
[[ "$response" == "$marker" ]] || fail 'Unexpected response from web service inside Compose network.'
ok 'Database container reached web by service name'

step 'PostgreSQL and named volume persistence'
"${C[@]}" exec -T db psql -X -v ON_ERROR_STOP=1 -U smoke -d smoke -c 'SELECT version();'
"${C[@]}" exec -T db psql -X -v ON_ERROR_STOP=1 -U smoke -d smoke \
  -c "CREATE TABLE smoke_test (value text NOT NULL); INSERT INTO smoke_test VALUES ('${marker}');"
# Remove and recreate only the disposable DB container; retain its named volume.
"${C[@]}" rm --stop --force db
"${C[@]}" up -d --wait --wait-timeout 120 db
# Use a TCP connection to avoid the temporary initialization-only Unix socket.
actual=$("${C[@]}" exec -T -e PGPASSWORD=smoke-only db psql -X -v ON_ERROR_STOP=1 -h 127.0.0.1 -U smoke -d smoke -Atc 'SELECT value FROM smoke_test;')
[[ "$actual" == "$marker" ]] || fail 'Database row did not survive container recreation.'
ok 'PostgreSQL data survived container recreation'

# EXIT trap removes the disposable project and reports final success/failure.
